{
  "expo": {
    "name": "Pasaje Club Hub",
    "slug": "pasajeclub-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pasajeclub",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pasajeclub.hub",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "PC Hub"
      }
    },
    "android": {
      "package": "com.pasajeclub.hub",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/isotipo.png",
        "backgroundColor": "#072E40"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#072E40",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#11BCB3"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pasaje Club usa tus fotos para que puedas adjuntarlas al muro, a las conversaciones del CRM y a los reconocimientos.",
          "cameraPermission": "Pasaje Club usa la camara para que puedas sacar una foto y adjuntarla al muro, al CRM o a un reconocimiento."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Pasaje Club usa el microfono para grabar notas de voz y mandarlas a tus clientes por el CRM o preguntarle a Pasajito."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-asset"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "b3a77918-2a8b-47b1-993c-649516baf1af"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b3a77918-2a8b-47b1-993c-649516baf1af"
    },
    "owner": "pasaje-club"
  }
}
